// ─────────────────────────────────────────────────────────────────────────────
// RegistreNatal — schema.prisma
// Compatible : Prisma 7.x · PostgreSQL (Neon serverless)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Décommenter si tu utilises le connection pooling Neon en production :
  // directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  CITOYEN
  OFFICIER
  ADMIN
}

enum StatutDeclaration {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum TypeExtrait {
  INTEGRALE
  AVEC_FILIATION
  SANS_FILIATION
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  nom       String
  prenom    String
  role      Role     @default(CITOYEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  declarations Declaration[] @relation("CitoyenDeclarations")
  validations  Declaration[] @relation("OfficierValidations")
  extraits     Extrait[]
  logs         AuditLog[]

  @@index([clerkId])
  @@index([role])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// DECLARATION
// ─────────────────────────────────────────────────────────────────────────────

model Declaration {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relation citoyen
  citoyen   User   @relation("CitoyenDeclarations", fields: [citoyenId], references: [id], onDelete: Cascade)
  citoyenId String

  // Relation officier (null jusqu'à validation/rejet)
  officier   User?   @relation("OfficierValidations", fields: [officierId], references: [id])
  officierId String?

  // ── Informations de l'enfant ──────────────────────────────────────────────
  prenomEnfant  String
  nomEnfant     String
  dateNaissance DateTime
  lieuNaissance String
  sexe          String   // "M" | "F"

  // ── Filiation — Père ──────────────────────────────────────────────────────
  nomPere         String
  prenomPere      String
  professionPere  String?  // ← NOUVEAU
  nationalitePere String?  // ← NOUVEAU
  residencePere   String?  // ← NOUVEAU

  // ── Filiation — Mère ──────────────────────────────────────────────────────
  nomMere         String
  prenomMere      String
  professionMere  String?  // ← NOUVEAU
  nationaliteMere String?  // ← NOUVEAU
  residenceMere   String?  // ← NOUVEAU

  // ── Statut ────────────────────────────────────────────────────────────────
  statut     StatutDeclaration @default(EN_ATTENTE)
  motifRejet String?

  // Relations enfants
  acte     Acte?
  extraits Extrait[]

  @@index([citoyenId])
  @@index([officierId])
  @@index([statut])
  @@index([nomEnfant])
  @@index([prenomEnfant])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACTE
// ─────────────────────────────────────────────────────────────────────────────

model Acte {
  id             String   @id @default(cuid())
  numero         String   @unique
  dateValidation DateTime @default(now())

  declaration   Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  declarationId String      @unique

  @@index([numero])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTRAIT
// ─────────────────────────────────────────────────────────────────────────────

model Extrait {
  id        String      @id @default(cuid())
  type      TypeExtrait
  pdfUrl    String?
  createdAt DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  declaration   Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  declarationId String

  @@index([userId])
  @@index([declarationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDITLOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
