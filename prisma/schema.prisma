// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  CITOYEN
  OFFICIER
  ADMIN
}

enum StatutDeclaration {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum TypeExtrait {
  INTEGRALE
  AVEC_FILIATION
  SANS_FILIATION
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Créé automatiquement via le webhook Clerk (user.created)
// Mis à jour via webhook (user.updated)
// Supprimé via webhook (user.deleted)
// Utilisé par : requireAuth(), requireRole(), toutes les API routes
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique           // ID Clerk — lien entre Clerk et la DB
  email     String   @unique
  nom       String
  prenom    String
  role      Role     @default(CITOYEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  declarations Declaration[] @relation("CitoyenDeclarations")  // déclarations soumises par ce citoyen
  validations  Declaration[] @relation("OfficierValidations")  // déclarations traitées par cet officier
  extraits     Extrait[]                                       // extraits demandés par cet utilisateur
  logs         AuditLog[]                                      // actions de cet utilisateur

  @@index([clerkId])
  @@index([role])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// DECLARATION
// Soumise par un citoyen, traitée par un officier
// Utilisée par :
//   GET  /api/declarations        → liste filtrée par rôle
//   POST /api/declarations        → créer (citoyen)
//   GET  /api/declarations/[id]   → détail
//   DELETE /api/declarations/[id] → supprimer (citoyen si EN_ATTENTE, admin toujours)
//   POST /api/declarations/[id]/validate → valider ou rejeter (officier/admin)
// ─────────────────────────────────────────────────────────────────────────────

model Declaration {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relation citoyen
  citoyen   User   @relation("CitoyenDeclarations", fields: [citoyenId], references: [id], onDelete: Cascade)
  citoyenId String

  // Relation officier (null jusqu'à validation/rejet)
  officier   User?   @relation("OfficierValidations", fields: [officierId], references: [id])
  officierId String?

  // ── Informations de l'enfant ──────────────────────────────────────────────
  prenomEnfant  String
  nomEnfant     String
  dateNaissance DateTime
  lieuNaissance String
  sexe          String   // "M" | "F"

  // ── Filiation ─────────────────────────────────────────────────────────────
  nomPere    String
  prenomPere String
  nomMere    String
  prenomMere String

  // ── Statut ────────────────────────────────────────────────────────────────
  statut     StatutDeclaration @default(EN_ATTENTE)
  motifRejet String?           // renseigné uniquement si statut = REJETEE

  // Relations enfants
  acte    Acte?     // créé lors de la validation
  extraits Extrait[] // extraits demandés sur cette déclaration

  @@index([citoyenId])
  @@index([officierId])
  @@index([statut])
  @@index([nomEnfant])
  @@index([prenomEnfant])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACTE
// Créé automatiquement lors de la validation d'une déclaration (transaction Prisma)
// Contient le numéro d'acte officiel généré par generateNumeroActe()
// Utilisé par :
//   POST /api/declarations/[id]/validate → créé dans la transaction
//   GET  /api/declarations/[id]          → inclus dans la réponse
//   GET  /api/extraits/[id]/pdf          → numéro affiché sur le PDF
// ─────────────────────────────────────────────────────────────────────────────

model Acte {
  id             String   @id @default(cuid())
  numero         String   @unique  // ex: "ACT-2025-ABC123-XY"
  dateValidation DateTime @default(now())

  // Relation
  declaration   Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  declarationId String      @unique  // 1 déclaration → 1 acte max

  @@index([numero])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTRAIT
// Demande d'extrait sur une déclaration validée
// Utilisé par :
//   GET  /api/extraits          → liste (filtrée par rôle)
//   POST /api/extraits          → créer une demande
//   GET  /api/extraits/[id]     → détail
//   GET  /api/extraits/[id]/pdf → génère le PDF et le stream
// ─────────────────────────────────────────────────────────────────────────────

model Extrait {
  id        String      @id @default(cuid())
  type      TypeExtrait
  pdfUrl    String?     // URL de stockage si on sauvegarde le PDF (optionnel)
  createdAt DateTime    @default(now())

  // Relation utilisateur (celui qui a fait la demande)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Relation déclaration
  declaration   Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  declarationId String

  @@index([userId])
  @@index([declarationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDITLOG
// Trace toutes les actions importantes pour la supervision admin
// Utilisé par :
//   POST /api/declarations              → DECLARATION_CREEE
//   DELETE /api/declarations/[id]       → DECLARATION_SUPPRIMEE
//   POST /api/declarations/[id]/validate → DECLARATION_VALIDEE | DECLARATION_REJETEE
//   POST /api/extraits                  → EXTRAIT_DEMANDE
//   GET  /api/extraits/[id]/pdf         → EXTRAIT_TELECHARGE
//   PATCH /api/users/[id]/role          → ROLE_MODIFIE
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // ex: "DECLARATION_CREEE", "DECLARATION_VALIDEE", etc.
  details   Json?    // données contextuelles (declarationId, motif, etc.)
  createdAt DateTime @default(now())

  // Relation utilisateur
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
